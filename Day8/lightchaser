module lightchaser(
    input wire clk,
    input wire rst_n,
    input wire hold_n,
    output reg [3:0] SR_out
);

always @(posedge clk or negedge rst_n) begin
    if(!rst_n) SR_out<=4'b0111;
    
    else begin 
        if (!hold_n) SR_out<=SR_out;              
        else SR_out={SR_out[0],SR_out[3:1]};  
    end


end
    
endmodule
